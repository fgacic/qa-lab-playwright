{
  "name": "qa-lab-playwright",
  "version": "1.0.0",
  "description": "Playwright UI suite for the Toolshop practice web shop",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:mocked": "playwright test --grep @mocked",
    "test:verify-bugs": "node scripts/verify-bugs.mjs",
    "test:account": "playwright test --project=account",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results",
    "report:html": "playwright show-report",
    "test:admin": "playwright test --project=admin",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "toolshop:up": "scripts/toolshop.sh up",
    "toolshop:reseed": "scripts/toolshop.sh reseed",
    "toolshop:down": "scripts/toolshop.sh down",
    "test:live": "TARGET=live playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:visual": "scripts/visual.sh",
    "test:visual:update": "scripts/visual.sh --update-snapshots",
    "test:security": "playwright test --grep @security",
    "test:perf": "playwright test --project=chromium --grep @perf",
    "test:i18n": "playwright test --project=chromium --grep @i18n"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "allure": "3.21.0",
    "allure-playwright": "3.14.0",
    "typescript": "5.7.2"
  },
  "private": true
}
