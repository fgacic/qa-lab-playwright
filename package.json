{
  "name": "qa-lab-playwright",
  "version": "1.0.0",
  "description": "Playwright UI suite for the Toolshop practice web shop",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:mocked": "playwright test --grep @mocked",
    "test:verify-bugs": "VERIFY_BUGS=1 playwright test --project=chromium --grep @bug",
    "test:account": "RUN_ACCOUNT_TESTS=1 playwright test --project=account",
    "typecheck": "tsc --noEmit",
    "report": "allure generate allure-results -o allure-report --clean",
    "report:html": "playwright show-report",
    "test:admin": "RUN_ADMIN_TESTS=1 playwright test --project=admin",
    "test:a11y": "playwright test --project=chromium --grep @a11y"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.14.0",
    "typescript": "5.7.2"
  },
  "private": true
}
