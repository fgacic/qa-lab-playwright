{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@fixtures": ["fixtures/index.ts"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@support/*": ["src/support/*"]
    },
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "src", "fixtures", "tests"]
}
